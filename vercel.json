{
  "functions": {
    "api/og.js": {
      "includeFiles": "{api/Geist-Regular.ttf,node_modules/@resvg/resvg-wasm/index_bg.wasm}"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Ww]hats[Aa]pp|[Ff]acebook|[Ff]acebot|[Ii]nstagram|[Tt]witterbot|[Tt]elegram|[Ll]inked[Ii]n|[Ss]lackbot|[Dd]iscordbot|meta-externalagent|[Ee]mbedly).*"
        }
      ],
      "destination": "/api/s"
    },
    {
      "source": "/s",
      "destination": "/api/s"
    }
  ]
}
